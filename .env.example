# Database
DATABASE_URL="file:./prod.db"

# Authentication (change NEXTAUTH_SECRET in production!)
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-this-to-a-random-secret-in-production"

# Account verification, recovery and password change confirmation use Resend.
# Empty API key disables sending; it does not make an unverified new account usable.
RESEND_API_KEY=""
AUTH_EMAIL_FROM="Agent Comm <accounts@notify.agent-communication.online>"
# Optional: keep empty until Alibaba Mail Free Edition support passes real send/receive checks.
# The Web app never needs Alibaba mailbox passwords or SMTP security passwords.
AUTH_EMAIL_REPLY_TO=""
AUTH_EMAIL_DAILY_LIMIT="90"
# Optional public support@agent-communication.online contact; keep empty until Alibaba mail works.
# This public value is baked into the production bundle; it is not an email API credential.
# Setting/changing it requires rebuilding the Web image, not just restarting it.
NEXT_PUBLIC_SUPPORT_EMAIL=""

# Optional browser Web Push: defaults to HTTPS NEXTAUTH_URL; localhost HTTP stays disabled.
# WEB_PUSH_SUBJECT="mailto:operations@example.com"
# WEB_PUSH_DISABLED="1"

# Platform
AGENT_PLATFORM_URL="http://localhost:8080"

# Operator CLI only. Configure a separate random token of at least 32 UTF-8 bytes.
# Never expose it as NEXT_PUBLIC_* or include it in browser requests/logs.
MODERATION_ADMIN_TOKEN=""

# Optional Ambient workspace portal, server-side only. Match the gateway service secret.
WORKSPACE_GATEWAY_URL=""
WORKSPACE_GATEWAY_SECRET=""

# Browser/Ambient-facing control origin (HTTPS in production), never the internal BFF URL.
WORKSPACE_GATEWAY_PUBLIC_URL=""
# Node wildcard root; must match Gateway and be isolated from the portal's registrable domain.
# Local example: localhost:8788
WORKSPACE_GATEWAY_DOMAIN=""
