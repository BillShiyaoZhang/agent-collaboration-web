import React, {Suspense} from 'react';
import {PolicyDisclosureGate,usePolicyAccess} from '@/components/workbench/policy-disclosure';
let serverReady=false;
const serverPending=new Promise(resolve=>setTimeout(()=>{serverReady=true;resolve(true)},50));
function Template({server=false}:{server?:boolean}){
 const allowed=usePolicyAccess();if(typeof window!=='undefined'){((window as any).__trace||=[]).push({at:performance.now(),allowed,ready:(window as any).__templateReady,phase:'template'});}
 if(server&&!serverReady)throw serverPending;
 if(!server&&typeof window!=='undefined'&&!(window as any).__templateReady)throw (window as any).__templatePending;
 return <div className="page-enter flex h-full min-h-0 flex-col" data-template><h1>Saved history</h1><span data-allowed>{String(allowed)}</span></div>;
}
export function App({server=false}:{server?:boolean}){return <main><PolicyDisclosureGate compact><div><Suspense fallback={<p data-loading>Loading saved history</p>}><Template server={server}/></Suspense></div></PolicyDisclosureGate></main>;}
