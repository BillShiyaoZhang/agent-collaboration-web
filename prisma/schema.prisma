generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "linux-musl-arm64-openssl-3.0.x"]
}
datasource db {
  provider = "sqlite"
  url = env("DATABASE_URL")
}
// Account identity and encrypted workspace records are retained on the Web.
model User {
  id String @id @default(cuid())
  email String @unique
  passwordHash String
  virtualUrn String? @unique
  virtualEd25519PublicKey String?
  virtualEd25519PrivateKey String?
  virtualX25519PublicKey String?
  virtualX25519PrivateKey String?
  virtualKeySalt String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  agents Agent[]
  pushSubscriptions WebPushSubscription[]
  onboardingTickets OnboardingTicket[]
  managedCertificate ManagedConsoleCertificate?
  policyConsent UserPolicyConsent?
  controlPause UserControlPause?
}
// Signed platform-policy rollback guard and short-lived managed console grant.
model PlatformPolicyState {
  platformId String @id
  epoch BigInt
  policyHash String
}
model ManagedConsoleCertificate {
  userId String @id
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  platformId String
  issuerHash String
  certificate String
  expiresAt DateTime
}
// An account must explicitly acknowledge the exact signed compliance policy.
// Identity and agent pairing are retained when the policy changes.
model UserPolicyConsent {
  userId String @id
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  platformId String
  epoch BigInt
  policyHash String
  gatewayKeyId String
  confirmedAt DateTime @default(now())
}
// A user can suspend new Web control traffic without removing saved history.
model UserControlPause {
  userId String @id
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  pausedAt DateTime @default(now())
}
// A connection record is not ownership; the agent must pair the console locally.
model Agent {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  name String
  urn String
  publicKey String
  platformRegistered Boolean @default(false)
  lastActiveAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  requests ControlRequest[]
  workspaceState WorkspaceState?
  workspaceSnapshots WorkspaceSnapshot[]
  workspaceItems WorkspaceItem[]
  workspaceConversations WorkspaceConversation[]
  workspaceSubmission WorkspaceSubmission?
  notifications WorkspaceNotification[]
  notificationBaselines WorkspaceNotificationBaseline[]
  onboardingTickets OnboardingTicket[]
  @@index([userId])
  @@unique([userId, urn])
}

// A one-time public claim code never authorizes polling or grants agent access.
model OnboardingTicket {
  id String @id
  publicCode String @unique
  agentUrn String
  agentPublicKey String
  name String
  secretHash String
  requestHash String @unique
  methods String
  grantExpiresAt String
  ticketExpiresAt Float
  userId String?
  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)
  agentId String?
  agent Agent? @relation(fields: [agentId], references: [id], onDelete: Cascade)
  grant String?
  signature String?
  consolePublicKey String?
  completedAt Float?
  @@index([ticketExpiresAt], map: "OnboardingTicket_expiry_idx")
  @@index([agentUrn], map: "OnboardingTicket_agent_idx")
}
// Bounded delivery cache only: encrypted wire bytes, maximum ten-minute retention.
model ControlRequest {
  id String @id
  agentId String
  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)
  consoleUrn String
  method String
  fingerprint String
  requestEnvelope String
  responseEnvelope String?
  status String @default("pending")
  deadline DateTime
  expiresAt DateTime
  createdAt DateTime @default(now())
  @@index([agentId])
  @@index([expiresAt])
}

// Raw parameterized SQL keeps additive upgrades compatible with existing images.
// Payload fields below use authenticated encryption bound to account and record.
model WorkspaceState {
  agentId String @id
  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)
  activeConversationId String @default("")
  activeSelectedAt Float @default(0)
  status String @default("waiting")
  lastAttemptAt Float?
  lastSuccessAt Float?
  nextSyncAt Float @default(0)
  error String?
  failures Int @default(0)
  requestId String?
  plan String?
  leaseToken String?
  leaseUntil Float?
  lastWakeAt Float @default(0)
  @@index([nextSyncAt])
}
model WorkspaceSnapshot {
  agentId String
  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)
  method String
  recordKey String @default("")
  payload String
  sourceAt Float
  savedAt Float
  requestId String
  @@id([agentId, method, recordKey])
}
model WorkspaceItem {
  agentId String
  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)
  kind String
  itemId String
  conversationId String @default("")
  payload String
  sourceAt Float
  sortTime Float
  status String @default("")
  @@id([agentId, kind, itemId])
  @@index([agentId, kind, conversationId, sortTime, itemId], map: "WorkspaceItem_conversation_idx")
}
model WorkspaceConversation {
  agentId String
  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)
  conversationId String
  payload String
  sourceAt Float
  updatedAt Float
  @@id([agentId, conversationId])
  @@index([agentId, updatedAt])
}
model WorkspaceSubmission {
  agentId String @id
  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)
  requestId String
  payload String
  createdAt Float
  phase String @default("sending")
}

model WorkspaceNotification {
  seq Int @id @default(autoincrement())
  agentId String
  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)
  id String
  kind String
  state String
  revision Int
  readRevision Int @default(0)
  remoteRevision Int @default(0)
  sourceAt Float
  updatedAt Float
  expiresAt Float?
  systemEligible Int @default(0)
  payload String
  deliveries WorkspaceNotificationDelivery[]
  @@unique([agentId, id])
  @@index([agentId, seq], map: "WorkspaceNotification_agent_seq_idx")
}
model WorkspaceNotificationSequence {
  seq Int @id @default(autoincrement())
}
model WorkspaceNotificationBaseline {
  agentId String
  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)
  kind String
  complete Int @default(0)
  @@id([agentId, kind])
}
model WorkspaceNotificationDelivery {
  agentId String
  notificationId String
  revision Int
  deviceId String
  claimedAt Float
  notification WorkspaceNotification @relation(fields: [agentId, notificationId], references: [agentId, id], onDelete: Cascade)
  @@id([agentId, notificationId, revision, deviceId])
}

// Browser endpoints and VAPID private material are encrypted at rest.
model WebPushConfig {
  id String @id
  payload String
  createdAt Float
}
model WebPushSubscription {
  id String @id
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceId String
  endpointHash String @unique
  binding String
  payload String
  enabledAt Float
  expiresAt Float
  visibleUntil Float @default(0)
  active Int @default(1)
  lastTestAt Float @default(0)
  lastError String?
  deliveries WebPushDelivery[]
  @@unique([userId, deviceId])
}
model WebPushDelivery {
  id String @id
  subscriptionId String
  subscription WebPushSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  agentId String
  notificationId String
  revision Int
  kind String @default("notification")
  status String @default("pending")
  attempts Int @default(0)
  claimed Int @default(0)
  nextAttemptAt Float
  expiresAt Float
  leaseToken String?
  leaseUntil Float?
  updatedAt Float
  lastError String?
  @@unique([subscriptionId, agentId, notificationId, revision])
  @@index([status, nextAttemptAt], map: "WebPushDelivery_due_idx")
}
