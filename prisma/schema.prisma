generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "linux-musl-arm64-openssl-3.0.x"]
}
datasource db {
  provider = "sqlite"
  url = env("DATABASE_URL")
}
// Account identity and encrypted workspace records are retained on the Web.
model User {
  id String @id @default(cuid())
  email String @unique
  passwordHash String
  virtualUrn String? @unique
  virtualEd25519PublicKey String?
  virtualEd25519PrivateKey String?
  virtualX25519PublicKey String?
  virtualX25519PrivateKey String?
  virtualKeySalt String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  agents Agent[]
}
// A connection record is not ownership; the agent must pair the console locally.
model Agent {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  name String
  urn String
  publicKey String
  platformRegistered Boolean @default(false)
  lastActiveAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  requests ControlRequest[]
  workspaceState WorkspaceState?
  workspaceSnapshots WorkspaceSnapshot[]
  workspaceItems WorkspaceItem[]
  workspaceConversations WorkspaceConversation[]
  workspaceSubmission WorkspaceSubmission?
  @@index([userId])
  @@unique([userId, urn])
}
// Bounded delivery cache only: encrypted wire bytes, maximum ten-minute retention.
model ControlRequest {
  id String @id
  agentId String
  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)
  consoleUrn String
  method String
  fingerprint String
  requestEnvelope String
  responseEnvelope String?
  status String @default("pending")
  deadline DateTime
  expiresAt DateTime
  createdAt DateTime @default(now())
  @@index([agentId])
  @@index([expiresAt])
}

// Raw parameterized SQL keeps additive upgrades compatible with existing images.
// Payload fields below use authenticated encryption bound to account and record.
model WorkspaceState {
  agentId String @id
  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)
  activeConversationId String @default("")
  activeSelectedAt Float @default(0)
  status String @default("waiting")
  lastAttemptAt Float?
  lastSuccessAt Float?
  nextSyncAt Float @default(0)
  error String?
  failures Int @default(0)
  requestId String?
  plan String?
  leaseToken String?
  leaseUntil Float?
  lastWakeAt Float @default(0)
  @@index([nextSyncAt])
}
model WorkspaceSnapshot {
  agentId String
  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)
  method String
  recordKey String @default("")
  payload String
  sourceAt Float
  savedAt Float
  requestId String
  @@id([agentId, method, recordKey])
}
model WorkspaceItem {
  agentId String
  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)
  kind String
  itemId String
  conversationId String @default("")
  payload String
  sourceAt Float
  sortTime Float
  status String @default("")
  @@id([agentId, kind, itemId])
  @@index([agentId, kind, conversationId, sortTime, itemId], map: "WorkspaceItem_conversation_idx")
}
model WorkspaceConversation {
  agentId String
  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)
  conversationId String
  payload String
  sourceAt Float
  updatedAt Float
  @@id([agentId, conversationId])
  @@index([agentId, updatedAt])
}
model WorkspaceSubmission {
  agentId String @id
  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)
  requestId String
  payload String
  createdAt Float
  phase String @default("sending")
}
