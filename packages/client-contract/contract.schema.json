{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-comm:client-contract:v1",
  "title": "Agent collaboration client contract v1",
  "description": "BFF JSON contract; raw remote records retain extension fields. See README for authentication and units.",
  "oneOf": [
    {
      "$ref": "#/$defs/workspaceOverview"
    },
    {
      "$ref": "#/$defs/workspaceAgent"
    },
    {
      "$ref": "#/$defs/pendingCall"
    },
    {
      "$ref": "#/$defs/controlComplete"
    },
    {
      "$ref": "#/$defs/controlPending"
    },
    {
      "$ref": "#/$defs/workspaceAction"
    },
    {
      "$ref": "#/$defs/attentionPage"
    },
    {
      "$ref": "#/$defs/notificationPage"
    }
  ],
  "$defs": {
    "rpcMethod": {
      "enum": [
        "capabilities",
        "contacts.list",
        "collaboration.state",
        "inbox.list",
        "conversation.send",
        "conversation.get",
        "attention.list",
        "contacts.add",
        "approval.respond",
        "contacts.requests",
        "contacts.respond",
        "messages.send",
        "inbox.mark_read",
        "collaboration.execute"
      ]
    },
    "stableId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,128}$"
    },
    "pendingCall": {
      "type": "object",
      "properties": {
        "request_id": {
          "type": "string",
          "format": "uuid"
        },
        "method": {
          "$ref": "#/$defs/rpcMethod"
        },
        "params": {
          "type": "object"
        }
      },
      "required": [
        "request_id",
        "method",
        "params"
      ],
      "additionalProperties": false
    },
    "sync": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "waiting",
            "syncing",
            "ready",
            "offline",
            "needs_pairing",
            "policy_paused",
            "policy_unavailable"
          ]
        },
        "lastAttemptAt": {
          "type": [
            "number",
            "null"
          ],
          "description": "Unix milliseconds or null"
        },
        "lastSuccessAt": {
          "type": [
            "number",
            "null"
          ],
          "description": "Unix milliseconds or null"
        },
        "nextSyncAt": {
          "type": [
            "number",
            "null"
          ],
          "description": "Unix milliseconds or null"
        },
        "error": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "status",
        "lastAttemptAt",
        "lastSuccessAt",
        "nextSyncAt",
        "error"
      ]
    },
    "connection": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "urn": {
          "type": "string"
        },
        "platformRegistered": {
          "type": "boolean"
        },
        "lastActiveAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "sync": {
          "$ref": "#/$defs/sync"
        }
      },
      "required": [
        "id",
        "name",
        "urn",
        "platformRegistered",
        "lastActiveAt",
        "createdAt",
        "sync"
      ]
    },
    "snapshot": {
      "type": "object",
      "properties": {
        "data": {
          "type": "object"
        },
        "time": {
          "type": "number",
          "description": "Unix milliseconds"
        },
        "requestId": {
          "type": "string"
        },
        "sourceAt": {
          "type": "number",
          "description": "Read request creation time, in Unix milliseconds; used to refresh reads predating a completed action"
        }
      },
      "required": [
        "data",
        "time"
      ]
    },
    "conversationSummary": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/stableId"
        },
        "title": {
          "type": "string"
        },
        "updatedAt": {
          "type": "number",
          "description": "Unix milliseconds"
        },
        "pending": {
          "type": "boolean"
        },
        "turnCount": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "id",
        "title",
        "updatedAt",
        "pending",
        "turnCount"
      ]
    },
    "submission": {
      "type": "object",
      "properties": {
        "call": {
          "$ref": "#/$defs/pendingCall"
        },
        "text": {
          "type": "string"
        },
        "conversationId": {
          "$ref": "#/$defs/stableId"
        },
        "turnId": {
          "$ref": "#/$defs/stableId"
        },
        "phase": {
          "enum": [
            "sending",
            "uncertain"
          ]
        },
        "retryable": {
          "type": "boolean"
        }
      },
      "required": [
        "call",
        "text",
        "conversationId",
        "turnId",
        "phase",
        "retryable"
      ]
    },
    "workspaceOverview": {
      "type": "object",
      "properties": {
        "connections": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/connection"
          }
        },
        "notifications": {
          "type": "object",
          "required": [
            "unread",
            "pending"
          ],
          "properties": {
            "unread": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "pending": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          }
        }
      },
      "required": [
        "connections"
      ]
    },
    "workspaceAgent": {
      "type": "object",
      "properties": {
        "agent": {
          "$ref": "#/$defs/connection"
        },
        "identity": {
          "type": "object",
          "properties": {
            "virtualUrn": {
              "type": [
                "string",
                "null"
              ]
            },
            "virtualEd25519PublicKey": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "virtualUrn",
            "virtualEd25519PublicKey"
          ]
        },
        "sync": {
          "$ref": "#/$defs/sync"
        },
        "snapshots": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/snapshot"
          }
        },
        "conversations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/conversationSummary"
          }
        },
        "activeConversationId": {
          "type": "string"
        },
        "conversation": {
          "type": [
            "object",
            "null"
          ]
        },
        "hasEarlierTurns": {
          "type": "boolean"
        },
        "submission": {
          "anyOf": [
            {
              "$ref": "#/$defs/submission"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "agent",
        "identity",
        "sync",
        "snapshots",
        "conversations",
        "activeConversationId",
        "conversation",
        "hasEarlierTurns",
        "submission"
      ]
    },
    "controlResponse": {
      "type": "object",
      "properties": {
        "protocol": {
          "const": "agent-comm-control/v1"
        },
        "type": {
          "const": "response"
        },
        "request_id": {
          "type": "string",
          "format": "uuid"
        },
        "agent_urn": {
          "type": "string"
        },
        "console_urn": {
          "type": "string"
        },
        "deadline": {
          "type": "string",
          "format": "date-time"
        },
        "method": {
          "$ref": "#/$defs/rpcMethod"
        },
        "result": {
          "type": "object"
        },
        "error": {
          "type": "object",
          "properties": {
            "code": {
              "type": "string"
            },
            "message": {
              "type": "string"
            }
          },
          "required": [
            "code",
            "message"
          ]
        }
      },
      "required": [
        "protocol",
        "type",
        "request_id",
        "agent_urn",
        "console_urn",
        "deadline",
        "method"
      ],
      "additionalProperties": false,
      "oneOf": [
        {
          "required": [
            "result"
          ],
          "not": {
            "required": [
              "error"
            ]
          }
        },
        {
          "required": [
            "error"
          ],
          "not": {
            "required": [
              "result"
            ]
          }
        }
      ]
    },
    "controlComplete": {
      "type": "object",
      "properties": {
        "request_id": {
          "type": "string",
          "format": "uuid"
        },
        "status": {
          "const": "complete"
        },
        "response": {
          "$ref": "#/$defs/controlResponse"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "request_id",
        "status",
        "response",
        "expires_at"
      ]
    },
    "controlPending": {
      "type": "object",
      "properties": {
        "request_id": {
          "type": "string",
          "format": "uuid"
        },
        "status": {
          "enum": [
            "pending",
            "expired"
          ]
        },
        "deadline": {
          "type": "string",
          "format": "date-time"
        },
        "message": {
          "type": "string"
        }
      },
      "required": [
        "request_id",
        "status",
        "deadline",
        "message"
      ]
    },
    "workspaceAction": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "action": {
              "const": "select_conversation"
            },
            "conversationId": {
              "anyOf": [
                {
                  "$ref": "#/$defs/stableId"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "action",
            "conversationId"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "action": {
              "const": "dismiss_submission"
            },
            "requestId": {
              "type": "string",
              "format": "uuid"
            }
          },
          "required": [
            "action",
            "requestId"
          ],
          "additionalProperties": false
        }
      ]
    },
    "syncRequest": {
      "type": "object",
      "properties": {
        "agentId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "attentionItem": {
      "type": "object",
      "required": [
        "attention_id",
        "kind",
        "subject_id",
        "source_revision",
        "revision",
        "state",
        "title",
        "safe_summary",
        "target",
        "created_at",
        "updated_at"
      ],
      "properties": {
        "attention_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "kind": {
          "type": "string"
        },
        "subject_id": {
          "type": "string"
        },
        "task_id": {
          "type": "string"
        },
        "source_revision": {
          "type": [
            "string",
            "integer"
          ]
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "state": {
          "enum": [
            "open",
            "resolved",
            "superseded",
            "expired"
          ]
        },
        "title": {
          "type": "string",
          "maxLength": 1000
        },
        "safe_summary": {
          "type": "string",
          "maxLength": 8000
        },
        "target": {
          "type": "object",
          "required": [
            "kind",
            "id"
          ],
          "properties": {
            "kind": {
              "enum": [
                "task",
                "inbox",
                "approval",
                "contact",
                "conversation"
              ]
            },
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "turn_id": {
              "$ref": "#/$defs/stableId"
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "kind": {
                    "const": "conversation"
                  }
                }
              },
              "then": {
                "required": [
                  "turn_id"
                ],
                "properties": {
                  "id": {
                    "$ref": "#/$defs/stableId"
                  }
                }
              }
            }
          ]
        },
        "created_at": {
          "type": "number",
          "minimum": 0
        },
        "updated_at": {
          "type": "number",
          "minimum": 0
        },
        "expires_at": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "attentionPage": {
      "type": "object",
      "required": [
        "schema",
        "items",
        "cursor",
        "has_more"
      ],
      "properties": {
        "schema": {
          "const": "agent-comm-attention/v1"
        },
        "items": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/attentionItem"
          }
        },
        "cursor": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "has_more": {
          "type": "boolean"
        }
      }
    },
    "workspaceNotification": {
      "type": "object",
      "required": [
        "id",
        "agentId",
        "agentName",
        "revision",
        "unread",
        "requiresAction",
        "kind",
        "state",
        "title",
        "summary",
        "target",
        "href",
        "updatedAt",
        "observedAt",
        "expiresAt",
        "systemEligible",
        "source",
        "sync"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "agentId": {
          "type": "string"
        },
        "agentName": {
          "type": "string"
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "unread": {
          "type": "boolean"
        },
        "requiresAction": {
          "type": "boolean"
        },
        "kind": {
          "type": "string"
        },
        "state": {
          "enum": [
            "open",
            "resolved",
            "superseded",
            "expired"
          ]
        },
        "title": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "target": {
          "$ref": "#/$defs/attentionItem/properties/target"
        },
        "href": {
          "type": "string"
        },
        "updatedAt": {
          "type": "number"
        },
        "observedAt": {
          "type": "number"
        },
        "expiresAt": {
          "type": [
            "number",
            "null"
          ]
        },
        "systemEligible": {
          "type": "boolean"
        },
        "source": {
          "enum": [
            "attention",
            "snapshot"
          ]
        },
        "sync": {
          "$ref": "#/$defs/sync"
        }
      }
    },
    "notificationPage": {
      "type": "object",
      "required": [
        "items",
        "unread",
        "pending",
        "before",
        "hasMore"
      ],
      "properties": {
        "items": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "$ref": "#/$defs/workspaceNotification"
          }
        },
        "unread": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "pending": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "before": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "hasMore": {
          "type": "boolean"
        }
      }
    },
    "sourceContext": {
      "type": "object",
      "properties": {
        "origin": {
          "enum": [
            "paired_conversation",
            "paired_control"
          ]
        },
        "conversation_id": {
          "$ref": "#/$defs/stableId"
        },
        "turn_id": {
          "$ref": "#/$defs/stableId"
        },
        "request_id": {
          "$ref": "#/$defs/stableId"
        }
      },
      "required": [
        "origin"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "origin": {
                "const": "paired_conversation"
              }
            }
          },
          "then": {
            "required": [
              "conversation_id",
              "turn_id"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "origin": {
                "const": "paired_control"
              }
            }
          },
          "then": {
            "required": [
              "request_id"
            ],
            "not": {
              "required": [
                "turn_id"
              ]
            }
          }
        }
      ],
      "description": "Trusted navigation provenance; does not grant consent or tool authority."
    },
    "conversationRelated": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "task",
            "approval",
            "collaboration"
          ]
        },
        "id": {
          "$ref": "#/$defs/stableId"
        },
        "task_id": {
          "$ref": "#/$defs/stableId"
        }
      },
      "required": [
        "kind",
        "id"
      ]
    },
    "conversationTurn": {
      "type": "object",
      "properties": {
        "turn_id": {
          "$ref": "#/$defs/stableId"
        },
        "status": {
          "enum": [
            "submitted",
            "running",
            "completed",
            "failed",
            "interrupted"
          ]
        },
        "text": {
          "type": "string"
        },
        "response": {
          "type": [
            "string",
            "null"
          ]
        },
        "error": {
          "type": [
            "string",
            "null"
          ]
        },
        "created_at": {
          "type": "number",
          "minimum": 0
        },
        "updated_at": {
          "type": "number",
          "minimum": 0
        },
        "related": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/conversationRelated"
          }
        }
      },
      "required": [
        "turn_id",
        "status",
        "text",
        "response",
        "error",
        "created_at",
        "updated_at"
      ]
    },
    "conversationResult": {
      "type": "object",
      "properties": {
        "conversation_id": {
          "$ref": "#/$defs/stableId"
        },
        "turns": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/conversationTurn"
          }
        },
        "history": {
          "type": "object",
          "properties": {
            "limit": {
              "const": 100
            },
            "returned": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            "truncated": {
              "type": "boolean"
            }
          },
          "required": [
            "limit",
            "returned",
            "truncated"
          ]
        }
      },
      "required": [
        "conversation_id",
        "turns"
      ]
    }
  }
}
